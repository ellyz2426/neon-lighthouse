<!-- hud.uikitml -->
<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 8;
    gap: 4;
    background-color: rgba(2, 8, 24, 0.85);
    border-radius: 10;
    border-color: rgba(255, 180, 50, 0.3);
    border-width: 1;
    width: 520;
    height: 100;
  }
  .top-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12;
    width: 500;
  }
  .stat-group {
    flex-direction: column;
    align-items: center;
    gap: 2;
  }
  .stat-label {
    font-size: 9;
    color: rgba(180, 200, 220, 0.6);
  }
  .stat-value {
    font-size: 16;
    color: #ffffff;
    font-weight: bold;
  }
  .score-value {
    font-size: 18;
    color: #ffb432;
    font-weight: bold;
  }
  .lives-value {
    font-size: 16;
    color: #44ddff;
    font-weight: bold;
  }
  .beam-value {
    font-size: 14;
    color: #88ff66;
    font-weight: bold;
  }
  .divider {
    width: 1;
    height: 36;
    background-color: rgba(255, 180, 50, 0.2);
  }
  .bottom-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 500;
    gap: 8;
  }
  .ship-types {
    flex-direction: row;
    align-items: center;
    gap: 10;
  }
  .type-badge {
    flex-direction: row;
    align-items: center;
    gap: 3;
  }
  .type-icon {
    font-size: 8;
    color: rgba(180, 200, 220, 0.7);
  }
  .type-count {
    font-size: 10;
    font-weight: bold;
  }
  .fishing-count {
    color: #4488cc;
  }
  .cargo-count {
    color: #cc8844;
  }
  .ferry-count {
    color: #ccccee;
  }
  .special-info {
    font-size: 11;
    color: #ff6644;
    font-weight: bold;
  }
  .wave-info {
    font-size: 9;
    color: #ffcc44;
    text-align: center;
  }
  .sonar-status {
    font-size: 9;
    color: #44ffaa;
    font-weight: bold;
  }
  .combo-display {
    font-size: 11;
    color: #ff9944;
    font-weight: bold;
  }
</style>
<Panel class="root">
  <div class="top-row">
    <div class="stat-group">
      <div class="stat-label">SCORE</div>
      <div class="score-value" id="score">0</div>
    </div>
    <div class="divider"></div>
    <div class="stat-group">
      <div class="stat-label">LIVES</div>
      <div class="lives-value" id="lives">3</div>
    </div>
    <div class="divider"></div>
    <div class="stat-group">
      <div class="stat-label">WAVE</div>
      <div class="stat-value" id="wave">1</div>
    </div>
    <div class="divider"></div>
    <div class="stat-group">
      <div class="stat-label">SHIPS</div>
      <div class="stat-value" id="ships-remaining">0</div>
    </div>
    <div class="divider"></div>
    <div class="stat-group">
      <div class="stat-label">BEAM</div>
      <div class="beam-value" id="beam-power">100%</div>
    </div>
  </div>
  <div class="bottom-row">
    <div class="ship-types">
      <div class="type-badge">
        <div class="type-icon">FISH</div>
        <div class="type-count fishing-count" id="fishing-count">0</div>
      </div>
      <div class="type-badge">
        <div class="type-icon">CARGO</div>
        <div class="type-count cargo-count" id="cargo-count">0</div>
      </div>
      <div class="type-badge">
        <div class="type-icon">FERRY</div>
        <div class="type-count ferry-count" id="ferry-count">0</div>
      </div>
    </div>
    <div class="special-info" id="special-info"></div>
    <div class="combo-display" id="combo-display"></div>
    <div class="sonar-status" id="sonar-status">SONAR: [F]</div>
    <div class="wave-info" id="wave-start-info"></div>
  </div>
</Panel>

<!-- compass.uikitml -->
<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 10;
    gap: 6;
    background-color: rgba(2, 8, 24, 0.75);
    border-radius: 10;
    border-color: rgba(255, 180, 50, 0.25);
    border-width: 1;
    width: 180;
  }
  .compass-label {
    font-size: 10;
    color: rgba(180, 200, 220, 0.6);
  }
  .compass-row {
    flex-direction: row;
    gap: 8;
    align-items: center;
  }
  .dir-indicator {
    flex-direction: column;
    align-items: center;
    gap: 2;
    width: 36;
  }
  .dir-letter {
    font-size: 14;
    color: rgba(180, 200, 220, 0.5);
    font-weight: bold;
  }
  .dir-active {
    font-size: 14;
    color: #ff6644;
    font-weight: bold;
  }
  .dir-dot {
    width: 6;
    height: 6;
    border-radius: 3;
    background-color: rgba(100, 120, 140, 0.3);
  }
  .dir-dot-active {
    width: 6;
    height: 6;
    border-radius: 3;
    background-color: #ff6644;
  }
  .center-dot {
    width: 8;
    height: 8;
    border-radius: 4;
    background-color: #ffb432;
  }
</style>
<Panel class="root">
  <div class="compass-label">INCOMING</div>
  <div class="compass-row">
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-nw">NW</div>
      <div class="dir-dot" id="dot-nw"></div>
    </div>
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-n">N</div>
      <div class="dir-dot" id="dot-n"></div>
    </div>
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-ne">NE</div>
      <div class="dir-dot" id="dot-ne"></div>
    </div>
  </div>
  <div class="compass-row">
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-w">W</div>
      <div class="dir-dot" id="dot-w"></div>
    </div>
    <div class="dir-indicator">
      <div class="center-dot"></div>
    </div>
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-e">E</div>
      <div class="dir-dot" id="dot-e"></div>
    </div>
  </div>
  <div class="compass-row">
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-sw">SW</div>
      <div class="dir-dot" id="dot-sw"></div>
    </div>
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-s">S</div>
      <div class="dir-dot" id="dot-s"></div>
    </div>
    <div class="dir-indicator">
      <div class="dir-letter" id="dir-se">SE</div>
      <div class="dir-dot" id="dot-se"></div>
    </div>
  </div>
</Panel>

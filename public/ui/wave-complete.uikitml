<!-- wave-complete.uikitml -->
<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 24;
    gap: 14;
    background-color: rgba(2, 8, 24, 0.94);
    border-radius: 16;
    border-color: rgba(100, 255, 150, 0.4);
    border-width: 2;
    width: 300;
  }
  .heading {
    font-size: 26;
    color: #66ff99;
    font-weight: bold;
  }
  .wave-num {
    font-size: 20;
    color: #ffffff;
    font-weight: bold;
  }
  .stat-row {
    flex-direction: row;
    justify-content: space-between;
    width: 240;
    padding-top: 4;
    padding-bottom: 4;
  }
  .stat-label {
    font-size: 14;
    color: rgba(180, 200, 220, 0.7);
  }
  .stat-val {
    font-size: 14;
    color: #ffffff;
    font-weight: bold;
  }
  .bonus-val {
    font-size: 14;
    color: #ffb432;
    font-weight: bold;
  }
  .stars {
    font-size: 22;
    color: #ffb432;
  }
  .btn {
    padding: 12;
    background-color: rgba(100, 255, 150, 0.15);
    border-radius: 8;
    border-color: rgba(100, 255, 150, 0.3);
    border-width: 1;
    width: 240;
    align-items: center;
    cursor: pointer;
    margin-top: 6;
  }
  .btn-text {
    font-size: 16;
    color: #ffffff;
    font-weight: bold;
  }
</style>
<Panel class="root">
  <div class="heading">WAVE COMPLETE</div>
  <div class="wave-num" id="wave-num">Wave 1</div>
  <div class="stat-row">
    <div class="stat-label">Ships Saved</div>
    <div class="stat-val" id="ships-saved">0</div>
  </div>
  <div class="stat-row">
    <div class="stat-label">Ships Lost</div>
    <div class="stat-val" id="ships-lost">0</div>
  </div>
  <div class="stat-row">
    <div class="stat-label">Bonus</div>
    <div class="bonus-val" id="bonus">+0</div>
  </div>
  <div class="stars" id="stars">- - -</div>
  <div class="btn" id="btn-next-wave">
    <div class="btn-text">NEXT WAVE</div>
  </div>
</Panel>
